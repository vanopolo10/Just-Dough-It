    - target: {fileID: 6539025872442151838, guid: 4130ffec859698244a34dfa216c3f8e8, type: 3}
      propertyPath: m_text
      value: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0443\u0432\u043B\u0435\u043A\u043B\u0438\u0441\u044C
        \u0437\u0430\u043C\u0435\u0448\u0438\u0432\u0430\u044F \u0442\u0435\u0441\u0442\u043E
        \u0438 \u0442\u0435\u043F\u0435\u0440\u044C \u0432\u0435\u0441\u044C \u0432\u0430\u0448
        \u0434\u043E\u043C \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D \u043F\u0438\u0440\u043E\u0436\u043A\u0430\u043C\u0438?
        \u0417\u0430\u0431\u044B\u043B\u0438 \u0432\u043E\u0432\u0440\u0435\u043C\u044F
        \u0434\u043E\u0441\u0442\u0430\u0442\u044C \u0442\u0435\u0441\u0442\u043E
        \u0438\u0437 \u043F\u0435\u0447\u0438, \u043D\u043E \u043D\u0435 \u0445\u043E\u0442\u0438\u0442\u0435
        \u043F\u043E\u0434\u0430\u0432\u0430\u0442\u044C \u0433\u043E\u0441\u0442\u044F\u043C
        \u043D\u0430 \u0443\u0436\u0438\u043D \u0443\u0433\u043E\u043B\u044C\u043A\u0438?
        \u041D\u0435 \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u0442\u0435\u0441\u044C!
        \u041D\u0430\u0448\u0430 \u043D\u043E\u0432\u0435\u0439\u0448\u0430\u044F
        \u0431\u0435\u0437\u0434\u043E\u043D\u043D\u0430\u044F* \u043A\u043E\u0440\u0437\u0438\u043D\u0430
        \u0443\u0436\u0435 \u0433\u043E\u0442\u043E\u0432\u0430 \u043F\u0440\u0438\u043D\u044F\u0442\u044C
        \u0432 \u0441\u0435\u0431\u044F \u043B\u044E\u0431\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
        \u043D\u0435\u043D\u0443\u0436\u043D\u044B\u0445 \u0432\u0430\u043C \u0445\u043B\u0435\u0431\u043E\u0431\u0443\u043B\u043E\u0447\u043D\u044B\u0445
        \u0438\u0437\u0434\u0435\u043B\u0438\u0439!"
      objectReference: {fileID: 0}
