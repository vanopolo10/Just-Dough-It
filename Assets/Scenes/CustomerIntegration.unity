      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 382910936079399639, guid: 4130ffec859698244a34dfa216c3f8e8, type: 3}
      propertyPath: m_text
      value: "\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u043C
        \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044E \u0441\u0430\u043C\u044B\u0445
        \u043F\u0440\u0435\u0434\u0430\u043D\u043D\u044B\u0445 \u0447\u0438\u0442\u0430\u0442\u0435\u043B\u0435\u0439
        \u0420\u0423\u041A\u0415\u0410 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435
        \u0441\u043B\u043E\u0432\u043E \u0442\u0435\u0441\u0442\u043E\u043C\u0435\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
        \u0442\u0435\u0445\u043D\u0438\u043A\u0438: \u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439*
        \u041D\u043E\u0436!                  \u0421 \u044D\u0442\u0438\u043C \u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C
        \u0434\u0440\u0443\u0433\u043E\u043C \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u043C\u0438
        \u043E\u0442\u043A\u0440\u043E\u044E\u0442\u0441\u044F \u0440\u0430\u043D\u0435\u0435
        \u043D\u0435\u0432\u0438\u0434\u0430\u043D\u043D\u044B\u0435 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u044B 
        \u043A\u0443\u043B\u0438\u043D\u0430\u0440\u043D\u043E\u0433\u043E \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0430!      
        \u041A\u0443\u043F\u0438\u0442\u0435 \u0441\u0435\u0439\u0447\u0430\u0441
        \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435 \u0432 \u043F\u043E\u0434\u0430\u0440\u043E\u043A
        \u0414\u0412\u0410(2) \u0440\u0435\u0446\u0435\u043F\u0442\u0430 \u0431\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
        \u0438\u0437\u0434\u0435\u043B\u0438\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
        \u0432\u043E\u0439\u0434\u0443\u0442 \u0432 \u043B\u044E\u0431\u0443\u044E
        \u043F\u043E\u0432\u0430\u0440\u0435\u043D\u043D\u0443\u044E \u043A\u043D\u0438\u0433\u0443
        \u043A\u0430\u043A \u0432\u043B\u0438\u0442\u044B\u0435!\n\n"
      objectReference: {fileID: 0}
    - target: {fileID: 382910936079399639, guid: 4130ffec859698244a34dfa216c3f8e8, type: 3}
