    - target: {fileID: 104791633288880878, guid: 4130ffec859698244a34dfa216c3f8e8, type: 3}
      propertyPath: m_text
      value: "\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u0435\u043C,
        \u0432\u044B \u0432\u044B\u043A\u0443\u043F\u0438\u043B\u0438 \u0432\u0435\u0441\u044C
        \u0430\u0441\u0441\u043E\u0440\u0442\u0438\u043C\u0435\u043D\u0442 \u0420\u0423\u041A\u0415\u0410
        \u0438 \u043F\u043E\u0431\u0435\u0434\u0438\u043B\u0438* \u043A\u0430\u043F\u0438\u0442\u0430\u043B\u0438\u0437\u043C!"
