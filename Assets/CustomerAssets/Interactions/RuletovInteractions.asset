  m_Script: {fileID: 11500000, guid: 3c61bc8f333ea674787900955b41b668, type: 3}
  m_Name: RuletovInteractions
  m_EditorClassIdentifier: Assembly-CSharp::CustomerInteractionSet
  _onGreeting:
    _interactionTexts:
    - "\u0412\u0435\u0447\u0435\u0440 \u0432 \u0445\u0430\u0442\u0443, \u0442\u043E\u0432\u0430\u0440\u0438\u0449"
    - "\u043C\u044B \u0442\u0443\u0442 \u0441 \u0431\u0440\u0430\u0442\u043A\u0430\u043C\u0438
      \u043F\u043E\u043A\u0443\u043C\u0435\u043A\u0430\u043B\u0438"
    - "\u0438 \u0440\u0435\u0448\u0438\u043B\u0438 \u0447\u0442\u043E \u0442\u0432\u043E\u044F
      \u043F\u0435\u043A\u0430\u0440\u043D\u044F - \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0439
      \u0431\u0438\u0437\u043D\u0435\u0441, \u0442\u0430\u043A \u0447\u0442\u043E..."
    - "\u0442\u0435\u043F\u0435\u0440\u044C \u043C\u044B \u0442\u0435\u0431\u044F
      \u043A\u0440\u044B\u0448\u0443\u0435\u043C."
    - "\u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u0434\u0430\u0432\u0430\u0439
      \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C\u0441\u044F \u043F\u043E-\u0445\u043E\u0440\u043E\u0448\u0435\u043C\u0443..."
    _animationTriggers:
    - 
    - 
    - 
    - 
    - 
  _onItemAccepted:
    _interactionTexts:
    - yeee
    - aga
    _animationTriggers: []
  _onItemRejected:
    _interactionTexts:
    - no
    _animationTriggers: []
  _onQuestCompleted:
    _interactionTexts:
    - "\u0434\u0440\u0443\u0436\u0438\u0449\u0435"
    - "\u0442\u044B \u0447\u0435-\u0442\u043E \u043F\u0435\u0440\u0435\u043F\u0443\u0442\u0430\u043B"
    _animationTriggers:
    - Stare
    - Nah
  _questDialogueOptions:
  - _textKey: "\u0410 \u0441\u0430\u043C-\u0442\u043E \u0442\u044B \u043A\u0442\u043E?"
    _interaction:
      _interactionTexts:
      - "\u0410\u0445 \u0434\u0430, \u0442\u043E\u0447\u043D\u043E, \u0442\u044B
        \u0436\u0435 \u0437\u0434\u0435\u0441\u044C \u043D\u043E\u0432\u0435\u043D\u044C\u043A\u0438\u0439..."
      - "\u041C\u0435\u0441\u0442\u043D\u044B\u0435 \u0437\u043E\u0432\u0443\u0442
        \u043C\u0435\u043D\u044F \u0420\u0443\u043B\u0435\u0442\u043E\u0432"
      - "...\u0438 \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u044E\u0442
        \u0441\u043E \u043C\u043D\u043E\u0439 \u043D\u0435 \u0441\u043F\u043E\u0440\u0438\u0442\u044C."
      _animationTriggers:
      - 
      - 
      - Nah
  - _textKey: "\u0414\u0435\u043D\u0435\u0433 \u0443 \u043C\u0435\u043D\u044F \u043D\u0435\u0442,
      \u043D\u043E \u0435\u0441\u0442\u044C \u043A\u043E\u0435-\u0447\u0442\u043E
      \u043F\u043E\u043B\u0443\u0447\u0448\u0435..."
    _interaction:
      _interactionTexts:
      - "\u041F\u043E\u043B\u0443\u0447\u0448\u0435 \u0434\u0435\u043D\u0435\u0433?
        \u0423\u0434\u0438\u0432\u0438 \u043C\u0435\u043D\u044F!"
      - "...\u0430 \u043F\u043E\u0442\u043E\u043C \u043A\u043E\u043D\u0447\u0430\u0439
        \u0432\u0430\u043B\u044F\u0442\u044C \u0434\u0443\u0440\u0430\u043A\u0430."
      _animationTriggers:
      - 
      - Nah
