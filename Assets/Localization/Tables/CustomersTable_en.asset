  m_TableData:
  - m_Id: 4724113408
    m_Localized: I'm boring Vasily, give me boring food.
    m_Metadata:
      m_Items: []
  - m_Id: 51159252992
    m_Localized: Too interesting!
    m_Metadata:
      m_Items: []
  - m_Id: 74647355392
    m_Localized: How boring, I'm going to go be bored some more!
    m_Metadata:
      m_Items: []
  - m_Id: 89100926976
    m_Localized: I'm picky Vasily, give me a cool pie!
    m_Metadata:
      m_Items: []
  - m_Id: 99356000256
    m_Localized: It's not very cool.
    m_Metadata:
      m_Items: []
  - m_Id: 109812400128
    m_Localized: Wow, that's awesome!
    m_Metadata:
      m_Items: []
  - m_Id: 127524945920
    m_Localized: MEAT
    m_Metadata:
      m_Items: []
  - m_Id: 131622780928
    m_Localized: BE...
    m_Metadata:
      m_Items: []
  - m_Id: 142771240960
    m_Localized: MMMM
    m_Metadata:
      m_Items: []
  - m_Id: 152057430016
    m_Localized: Give me long food so I can become even longer.
    m_Metadata:
      m_Items: []
  - m_Id: 177189699584
    m_Localized: This meal is too short.
    m_Metadata:
      m_Items: []
  - m_Id: 190355619840
    m_Localized: How long it is!
    m_Metadata:
      m_Items: []
  - m_Id: 821787115520
    m_Localized: Give me a cinnabon roll with jam. I have very specific tastes!
    m_Metadata:
      m_Items: []
  - m_Id: 834286141440
    m_Localized: My thirst for cinnabons is not fulfilled...
    m_Metadata:
      m_Items: []
  - m_Id: 845283606528
    m_Localized: Thanks! That's one cinnabon for me to remember!
    m_Metadata:
      m_Items: []
  references:
    version: 2
