  m_TableData:
  - m_Id: 49924583424
    m_Localized: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439, \u0432\u043D\u0443\u0447\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 133852606464
    m_Localized: "\u041C\u043E\u0436\u0435\u0448\u044C \u043C\u043D\u0435 \u043F\u0438\u0440\u043E\u0436\u043E\u043A
      \u0437\u0430\u0432\u0435\u0440\u043D\u0443\u0442\u044C, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 1510658060288
    m_Localized: "\u041F\u043E\u0433\u043E\u0434\u0438... \u0422\u0430\u043A \u044D\u0442\u043E\u0436
      \u043F\u0440\u043E\u0441\u0442\u043E \u0431\u0443\u043B\u043A\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 1758939885568
    m_Localized: "\u0412\u043E\u0442 \u0441\u043F\u0430\u0441\u0438\u0431\u043E,
      \u0432\u043D\u0443\u0447\u043E\u043A!"
    m_Metadata:
      m_Items: []
  - m_Id: 784586262753280
    m_Localized: "\u0412\u043E\u043E\u0431\u0449\u0435-\u0442\u043E \u044F \u0435\u0449\u0435
      \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u043B\u0441\u044F, \u043D\u043E
      \u043D\u0435 \u0431\u0443\u0434\u0443 \u0436\u0435 \u044F \u0434\u0435\u0434\u0443\u0448\u043A\u0435
      \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 786990186147840
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0430\u0434\u043E
      \u0440\u0430\u0441\u043A\u0430\u0442\u0430\u0442\u044C..."
    m_Metadata:
      m_Items: []
  - m_Id: 788562282590208
    m_Localized: "\u041A\u0430\u043A \u0442\u0430\u043C \u0434\u0430\u043B\u044C\u0448\u0435..?
      \u041D\u0430\u0434\u043E \u0433\u043B\u044F\u043D\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 343296698003456
    m_Localized: "\u041D\u0443 \u0434\u0430\u0432\u0430\u0439, \u043D\u0435 \u0442\u044F\u043D\u0438
      \u0442\u0430\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 342973342330880
    m_Localized: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E, \u0441\u0435\u0439\u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 4781362250559488
    m_Localized: "\u0412\u0441\u0435 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
      \u0441 \u0440\u0430\u0441\u043A\u0430\u0442\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 4781418970132480
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u043D\u0430\u0434\u043E \u0441\u043B\u043E\u0436\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 4781500616454144
    m_Localized: "\u0412\u043E\u0442 \u0442\u0443\u0442 \u0437\u0430\u0436\u043C\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 4781529372602368
    m_Localized: "\u0427\u0435\u0440\u0442! \u042F \u0437\u0430\u0431\u044B\u043B
      \u043D\u0430\u0447\u0438\u043D\u043A\u0443 \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 4781784918962176
    m_Localized: "\u0421\u0435\u0439\u0447\u0430\u0441 \u0431\u044B\u0441\u0442\u0440\u0435\u043D\u044C\u043A\u043E
      \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 4781864115810304
    m_Localized: "\u0412 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u044F \u043D\u0435
      \u0437\u0430\u0431\u0443\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 4781916146151424
    m_Localized: "\u041D\u0443 \u0432\u0440\u043E\u0434\u0435 \u0433\u043E\u0442\u043E\u0432!"
    m_Metadata:
      m_Items: []
  - m_Id: 4794554578153472
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0439 \u0443\u0436\u0435
      \u0441\u0432\u043E\u044E \u0437\u0430\u0431\u0435\u0433\u0430\u043B\u043E\u0432\u043A\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 5410195581976576
    m_Localized: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 B (\u0418) \u0447\u0442\u043E\u0431\u044B
      \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u043A\u043D\u0438\u0433\u0443 \u0440\u0435\u0446\u0435\u043F\u0442\u043E\u0432
      \u0438 \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043E\u0431\u044B\u0447\u043D\u044B\u0439
      \u043F\u0438\u0440\u043E\u0436\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 5410281082863616
    m_Localized: "\u0417\u0430\u0436\u043C\u0438\u0442\u0435 \u043B\u0435\u0432\u0443\u044E
      \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u044B\u0448\u0438 \u0447\u0442\u043E\u0431\u044B
      \u0432\u0437\u044F\u0442\u044C \u0441\u043A\u0430\u043B\u043A\u0443\n\u0417\u0430\u0436\u043C\u0438\u0442\u0435
      \u043F\u0440\u0430\u0432\u0443\u044E \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u044B\u0448\u0438
      \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0441\u043A\u0430\u0442\u0430\u0442\u044C "
    m_Metadata:
      m_Items: []
  - m_Id: 5410397290250240
    m_Localized: "\u0417\u0430\u0436\u043C\u0438\u0442\u0435 \u0438 \u043F\u0440\u043E\u0432\u0435\u0434\u0438\u0442\u0435
      \u043B\u0435\u0432\u0443\u044E \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u044B\u0448\u0438
      \u0447\u0442\u043E\u0431\u044B \u0441\u043B\u043E\u0436\u0438\u0442\u044C \u0442\u0435\u0441\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 5410465800011776
    m_Localized: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043F\u0440\u0430\u0432\u0443\u044E
      \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u044B\u0448\u0438 \u0447\u0442\u043E\u0431\u044B
      \u0437\u0430\u043C\u044F\u0442\u044C \u0442\u0435\u0441\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 5410562151563264
    m_Localized: "\u0422\u0435\u0441\u0442\u043E \u043C\u043E\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u0442\u0430\u0441\u043A\u0438\u0432\u0430\u0442\u044C
      \u0437\u0430\u0436\u0430\u0432 \u043E\u0431\u0435 \u043A\u043D\u043E\u043F\u043A\u0438
      \u043C\u044B\u0448\u0438.\n\u041F\u0435\u0440\u0435\u043D\u0435\u0441\u0438\u0442\u0435
      \u0438\u0437\u0434\u0435\u043B\u0438\u0435 \u0432 \u043C\u0438\u0441\u043A\u0443
      \u0441 \u0442\u0435\u0441\u0442\u043E\u043C \u0447\u0442\u043E\u0431\u044B
      \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u0441\u044F \u043E\u0442 \u043D\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 5410641658789888
    m_Localized: "\u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u043D\u043E\u0432\u044B\u0439
      \u043A\u0443\u0441\u043E\u043A \u0442\u0435\u0441\u0442\u0430 \u0438\u0437
      \u043C\u0438\u0441\u043A\u0438 \u043D\u0430\u0436\u0430\u0432 \u041B\u041A\u041C"
    m_Metadata:
      m_Items: []
  - m_Id: 5410779764637696
    m_Localized: "\u0414\u043E\u0431\u0430\u0432\u044C\u0442\u0435 \u043D\u0430 \u0442\u0435\u0441\u0442\u043E
      \u043B\u044E\u0431\u0443\u044E \u0438\u0437 \u043D\u0430\u0447\u0438\u043D\u043E\u043A
      \u0437\u0430\u0436\u0430\u0432 \u041B\u041A\u041C"
    m_Metadata:
      m_Items: []
  - m_Id: 5410856822390784
    m_Localized: "\u041F\u0435\u0440\u0435\u043D\u0435\u0441\u0438\u0442\u0435 \u0433\u043E\u0442\u043E\u0432\u043E\u0435
      \u0438\u0437\u0434\u0435\u043B\u0438\u0435 \u0432 \u043F\u0435\u0447\u044C
      \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0432 \u0435\u0433\u043E \u043D\u0430
      \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u0441 \u043E\u0433\u043D\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 5426067935608832
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0438\u044F
      \u0434\u0440\u043E\u0432, \u0438\u043C \u043D\u0443\u0436\u043D\u043E \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u0440\u0430\u0437\u0433\u043E\u0440\u0435\u0442\u044C\u0441\u044F. \u041A\u043E\u0433\u0434\u0430
      \u043E\u043D\u0438 \u043F\u0440\u043E\u0433\u043E\u0440\u044F\u0442, \u0438\u0445
      \u0436\u0430\u0440 \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E
      \u0443\u043C\u0435\u043D\u044C\u0448\u0438\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 5426142120263680
    m_Localized: "\u041D\u0443\u0436\u043D\u043E \u0441\u043B\u0435\u0434\u0438\u0442\u044C
      \u0437\u0430 \u043F\u0438\u0440\u043E\u0436\u043A\u0430\u043C\u0438 \u0438
      \u0432\u043E\u0432\u0440\u0435\u043C\u044F \u0434\u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C
      \u0438\u0445 \u0438\u0437 \u0433\u043E\u0440\u044F\u0447\u0435\u0439 \u043F\u0435\u0447\u0438.
      \u0421\u0442\u0435\u043F\u0435\u043D\u044C \u0433\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u0438
      \u043C\u043E\u0436\u043D\u043E \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C
      \u043F\u043E \u0432\u043D\u0435\u0448\u043D\u0435\u043C\u0443 \u0432\u0438\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 5796121808777216
    m_Localized: "\u041F\u043E\u0445\u043E\u0436\u0435, \u0447\u0442\u043E \u043F\u0440\u0438\u0448\u043B\u0430
      \u043F\u043E\u0440\u0430 \u043A\u0430\u0444\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 5829916545036288
    m_Localized: "\u0417\u0430\u043A\u0438\u043D\u0443-\u043A\u0430 \u0431\u0440\u0435\u0432\u043D\u044B\u0448\u043A\u043E,
      \u0435\u0433\u043E \u0434\u043E\u043B\u0436\u043D\u043E \u0445\u0432\u0430\u0442\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 5866986432933888
    m_Localized: "\u0422\u0430\u043A, \u0432 \u0442\u0435\u043C\u043F\u0435, \u043F\u043E\u043A\u0430
      \u0431\u0440\u0435\u0432\u043D\u043E \u0432\u0441\u0435 \u043D\u0435 \u043F\u0440\u043E\u0433\u043E\u0440\u0435\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 5867008893431808
    m_Localized: "\u041D\u0430\u0434\u043E \u0437\u0430\u0441\u043B\u043E\u043D\u043A\u0443
      \u0437\u0430\u043A\u0440\u044B\u0442\u044C, \u0447\u0442\u043E\u0431\u044B
      \u0436\u0430\u0440 \u043D\u0435 \u0432\u044B\u0445\u043E\u0434\u0438\u043B"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
