  m_TableData:
  - m_Id: 21770157354663936
    m_Localized: "\u0421\u0434\u0435\u043B\u0430\u0439\u0442\u0435 \u043C\u043D\u0435
      \u043F\u0438\u0440\u043E\u0436\u043A\u043E\u0432 \u0441 \u0434\u0436\u0435\u043C\u043E\u043C,
      \u043B\u0443\u0447\u0448\u0438\u0445 \u0447\u0442\u043E \u0443 \u0432\u0430\u0441
      \u0435\u0441\u0442\u044C... \u0422\u0440\u0438 \u0448\u0442\u0443\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 21770094654013440
    m_Localized: "\u0421\u0434\u0435\u043B\u0430\u0439\u0442\u0435-\u043A\u0430 \u043C\u043D\u0435
      \u0441\u0438\u043D\u043D\u0430\u0431\u043E\u043D. \u0415\u0441\u043B\u0438
      \u0432\u044B \u0432\u043E\u043E\u0431\u0449\u0435 \u0437\u043D\u0430\u0435\u0442\u0435
      \u0447\u0442\u043E \u044D\u0442\u043E \u0442\u0430\u043A\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 21769998608646144
    m_Localized: "\u0414\u0430\u0439\u0442\u0435 \u043C\u043D\u0435 \u0441\u043E\u0441\u0438\u0441\u043A\u0443
      \u0432 \u0442\u0435\u0441\u0442\u0435, \u043D\u043E \u0441\u0434\u0435\u043B\u0430\u0439\u0442\u0435
      \u0435\u0451... \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 21769877087076352
    m_Localized: "\u041C\u043D\u0435 \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430
      2 \u043F\u0438\u0440\u043E\u0436\u043A\u0430, \u043B\u044E\u0431\u044B\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 21769796778737664
    m_Localized: "\u0414\u0430\u0439\u0442\u0435 \u043C\u043D\u0435 \u0447\u0435\u0433\u043E-\u043D\u0438\u0442\u044C
      \u043F\u043E\u0435\u0441\u0442\u044C, \u0434\u0430 \u043F\u043E\u0431\u043E\u043B\u044C\u0448\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 21769688372756480
    m_Localized: "\u0417\u0430\u0432\u0435\u0440\u043D\u0438\u0442\u0435 \u043C\u043D\u0435
      \u043E\u0434\u0438\u043D \u043F\u0438\u0440\u043E\u0436\u043E\u043A \u0441
      \u043C\u044F\u0441\u043E\u043C, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 21769361946853376
    m_Localized: "\u041C\u043E\u0436\u043D\u043E \u043C\u043D\u0435 \u0434\u0432\u0435
      \u0441\u043E\u0441\u0438\u0441\u043A\u0438 \u0432 \u0442\u0435\u0441\u0442\u0435?
      \u041D\u0435 \u0432\u0430\u0436\u043D\u043E \u0441 \u043A\u0430\u043A\u043E\u0439
      \u043D\u0430\u0447\u0438\u043D\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  references:
