  m_TableData:
  - m_Id: 21770157354663936
    m_Localized: Make me some jam-filled pies, the best ones you have... Three of
      them.
    m_Metadata:
      m_Items: []
  - m_Id: 21770094654013440
    m_Localized: Make me a Cinnabon. If you even know what that is
    m_Metadata:
      m_Items: []
  - m_Id: 21769998608646144
    m_Localized: Give me a hot dog in a bun, but make it... something different
    m_Metadata:
      m_Items: []
  - m_Id: 21769877087076352
    m_Localized: "I\u2019d like two pies, please\u2014any kind will do"
    m_Metadata:
      m_Items: []
  - m_Id: 21769796778737664
    m_Localized: "Give me something to eat\u2014and a lot of it!"
    m_Metadata:
      m_Items: []
  - m_Id: 21769688372756480
    m_Localized: Please pack me one meat pie
    m_Metadata:
      m_Items: []
  - m_Id: 21769361946853376
    m_Localized: Can I have two sausages in pastry? It doesn't matter what kind of
      filling they have
    m_Metadata:
      m_Items: []
